<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_target.vcss_c" />
	</styles>

	<!-- uikit:target positions=t,b,l,r -->
	<!--
		GENERATED by `python -m uikit generate`.
		Target: 4 one-line label(s) around the crosshair (screen centre).
		Each sits in a half-screen zone whose inner edge is the centre. size-sm/md/lg/xl set the text size.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_target_root" class="uikit-fill hidden" hittest="false">
			<Panel class="target-zone target-zone-t" hittest="false">
				<Panel id="tg_t" class="target target-t size-md hidden" hittest="false">
					<Label class="target-text" hittest="false" text="{s:tg_t_text}" />
				</Panel>
			</Panel>
			<Panel class="target-zone target-zone-b" hittest="false">
				<Panel id="tg_b" class="target target-b size-md hidden" hittest="false">
					<Label class="target-text" hittest="false" text="{s:tg_b_text}" />
				</Panel>
			</Panel>
			<Panel class="target-zone target-zone-l" hittest="false">
				<Panel id="tg_l" class="target target-l size-md hidden" hittest="false">
					<Label class="target-text" hittest="false" text="{s:tg_l_text}" />
				</Panel>
			</Panel>
			<Panel class="target-zone target-zone-r" hittest="false">
				<Panel id="tg_r" class="target target-r size-md hidden" hittest="false">
					<Label class="target-text" hittest="false" text="{s:tg_r_text}" />
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
