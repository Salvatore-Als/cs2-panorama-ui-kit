<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_vote.vcss_c" />
	</styles>

	<!-- uikit:vote choices=5 -->
	<!--
		GENERATED by `python -m uikit generate`.
		Vote: a compact card on the right, a question, 5 choice(s) per page with a share, a count and a bar, pager, total, countdown.
		Takes the mouse. Clicks: vt_close, vt_prev, vt_next, vt_choice_<n>. Bars: p-0..p-20 on vt_choice_<n>_fill.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_vote_root" class="uikit-fill hidden" hittest="false">
			<Panel id="vt_screen" class="vote-screen" hittest="false">
				<Panel class="vote-card" hittest="false">
					<Panel class="vote-card-accent" hittest="false" />
					<Panel class="vote-head" hittest="false">
						<Panel class="vote-head-copy" hittest="false">
							<Label id="vt_kicker" class="vote-kicker" hittest="false" text="{s:vt_kicker}" />
							<Label class="vote-title" hittest="false" text="{s:vt_title}" />
						</Panel>
						<Button id="vt_close" class="vote-close">
							<Label class="vote-close-label" hittest="false" text="✕" />
						</Button>
					</Panel>
					<Panel class="vote-choices" hittest="false">
						<Button id="vt_choice_0" class="vote-choice hidden">
							<Panel class="vote-choice-line" hittest="false">
								<Label class="vote-choice-label" hittest="false" text="{s:vt_choice_0_label}" />
								<Label class="vote-choice-count" hittest="false" text="{s:vt_choice_0_count}" />
								<Label class="vote-choice-pct" hittest="false" text="{s:vt_choice_0_pct}" />
							</Panel>
							<Label id="vt_choice_0_sub" class="vote-choice-sub" hittest="false" text="{s:vt_choice_0_sub}" />
							<Panel class="vote-track" hittest="false">
								<Panel id="vt_choice_0_fill" class="vote-fill" hittest="false" />
							</Panel>
						</Button>
						<Button id="vt_choice_1" class="vote-choice hidden">
							<Panel class="vote-choice-line" hittest="false">
								<Label class="vote-choice-label" hittest="false" text="{s:vt_choice_1_label}" />
								<Label class="vote-choice-count" hittest="false" text="{s:vt_choice_1_count}" />
								<Label class="vote-choice-pct" hittest="false" text="{s:vt_choice_1_pct}" />
							</Panel>
							<Label id="vt_choice_1_sub" class="vote-choice-sub" hittest="false" text="{s:vt_choice_1_sub}" />
							<Panel class="vote-track" hittest="false">
								<Panel id="vt_choice_1_fill" class="vote-fill" hittest="false" />
							</Panel>
						</Button>
						<Button id="vt_choice_2" class="vote-choice hidden">
							<Panel class="vote-choice-line" hittest="false">
								<Label class="vote-choice-label" hittest="false" text="{s:vt_choice_2_label}" />
								<Label class="vote-choice-count" hittest="false" text="{s:vt_choice_2_count}" />
								<Label class="vote-choice-pct" hittest="false" text="{s:vt_choice_2_pct}" />
							</Panel>
							<Label id="vt_choice_2_sub" class="vote-choice-sub" hittest="false" text="{s:vt_choice_2_sub}" />
							<Panel class="vote-track" hittest="false">
								<Panel id="vt_choice_2_fill" class="vote-fill" hittest="false" />
							</Panel>
						</Button>
						<Button id="vt_choice_3" class="vote-choice hidden">
							<Panel class="vote-choice-line" hittest="false">
								<Label class="vote-choice-label" hittest="false" text="{s:vt_choice_3_label}" />
								<Label class="vote-choice-count" hittest="false" text="{s:vt_choice_3_count}" />
								<Label class="vote-choice-pct" hittest="false" text="{s:vt_choice_3_pct}" />
							</Panel>
							<Label id="vt_choice_3_sub" class="vote-choice-sub" hittest="false" text="{s:vt_choice_3_sub}" />
							<Panel class="vote-track" hittest="false">
								<Panel id="vt_choice_3_fill" class="vote-fill" hittest="false" />
							</Panel>
						</Button>
						<Button id="vt_choice_4" class="vote-choice hidden">
							<Panel class="vote-choice-line" hittest="false">
								<Label class="vote-choice-label" hittest="false" text="{s:vt_choice_4_label}" />
								<Label class="vote-choice-count" hittest="false" text="{s:vt_choice_4_count}" />
								<Label class="vote-choice-pct" hittest="false" text="{s:vt_choice_4_pct}" />
							</Panel>
							<Label id="vt_choice_4_sub" class="vote-choice-sub" hittest="false" text="{s:vt_choice_4_sub}" />
							<Panel class="vote-track" hittest="false">
								<Panel id="vt_choice_4_fill" class="vote-fill" hittest="false" />
							</Panel>
						</Button>
					</Panel>
					<Panel class="vote-foot" hittest="false">
						<Label class="vote-total" hittest="false" text="{s:vt_total}" />
						<Panel class="vote-pager" hittest="false">
							<Button id="vt_prev" class="vote-step">
								<Label class="vote-step-label" hittest="false" text="‹" />
							</Button>
							<Label class="vote-page" hittest="false" text="{s:vt_page}" />
							<Button id="vt_next" class="vote-step">
								<Label class="vote-step-label" hittest="false" text="›" />
							</Button>
						</Panel>
						<Label class="vote-time" hittest="false" text="{s:vt_time}" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
