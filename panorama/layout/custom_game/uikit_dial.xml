<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_dial.vcss_c" />
	</styles>

	<!-- uikit:dial placements=c,b,bl,br -->
	<!--
		GENERATED by `python -m uikit generate`.
		Dial: 4 ring(s), a value in the middle and a label under.
		The fill is a radial clip: step-N for a pushed value, timed + dur-N + run for a ring that runs alone.
		size-sm/md/lg/xl set the ring size.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_dial_root" class="uikit-fill hidden" hittest="false">
			<Panel id="dl_c" class="dial dial-c size-md hidden" hittest="false">
				<Panel class="dial-body" hittest="false">
					<Panel class="dial-track" hittest="false" />
					<Panel id="dl_c_fill" class="dial-fill" hittest="false" />
					<Label id="dl_c_value" class="dial-value" hittest="false" text="{s:dl_c_value}" />
				</Panel>
				<Label id="dl_c_label" class="dial-label" hittest="false" text="{s:dl_c_label}" />
			</Panel>
			<Panel id="dl_b" class="dial dial-b size-md hidden" hittest="false">
				<Panel class="dial-body" hittest="false">
					<Panel class="dial-track" hittest="false" />
					<Panel id="dl_b_fill" class="dial-fill" hittest="false" />
					<Label id="dl_b_value" class="dial-value" hittest="false" text="{s:dl_b_value}" />
				</Panel>
				<Label id="dl_b_label" class="dial-label" hittest="false" text="{s:dl_b_label}" />
			</Panel>
			<Panel id="dl_bl" class="dial dial-bl size-md hidden" hittest="false">
				<Panel class="dial-body" hittest="false">
					<Panel class="dial-track" hittest="false" />
					<Panel id="dl_bl_fill" class="dial-fill" hittest="false" />
					<Label id="dl_bl_value" class="dial-value" hittest="false" text="{s:dl_bl_value}" />
				</Panel>
				<Label id="dl_bl_label" class="dial-label" hittest="false" text="{s:dl_bl_label}" />
			</Panel>
			<Panel id="dl_br" class="dial dial-br size-md hidden" hittest="false">
				<Panel class="dial-body" hittest="false">
					<Panel class="dial-track" hittest="false" />
					<Panel id="dl_br_fill" class="dial-fill" hittest="false" />
					<Label id="dl_br_value" class="dial-value" hittest="false" text="{s:dl_br_value}" />
				</Panel>
				<Label id="dl_br_label" class="dial-label" hittest="false" text="{s:dl_br_label}" />
			</Panel>
		</Panel>
	</Panel>
</root>
