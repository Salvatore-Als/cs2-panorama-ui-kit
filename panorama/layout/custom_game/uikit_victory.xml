<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_victory.vcss_c" />
	</styles>

	<!-- uikit:victory chips=4 -->
	<!--
		GENERATED by `python -m uikit generate`.
		End of round screen: dark veil, one card, 4 chip(s), restart countdown.
		Elements enter one after the other through transition-delay: one "show", one write.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_victory_root" class="uikit-fill hidden" hittest="false">
			<Panel id="v_screen" class="victory-screen" hittest="false">
				<Panel class="victory-dim" hittest="false" />
				<Panel class="victory-card" hittest="false">
					<Panel class="victory-card-accent" hittest="false" />
					<Panel class="victory-body" hittest="false">
						<Label id="v_kicker" class="victory-kicker" hittest="false" text="{s:v_kicker}" />
						<Label class="victory-title" hittest="false" text="{s:v_title}" />
						<Panel class="victory-rule" hittest="false" />
						<Label id="v_subtitle" class="victory-subtitle" hittest="false" text="{s:v_subtitle}" />
						<Panel id="v_chips" class="victory-chips" hittest="false">
							<Panel id="v_chip_0" class="victory-chip hidden" hittest="false">
								<Panel class="victory-chip-accent" hittest="false" />
								<Label class="victory-chip-label" hittest="false" text="{s:v_chip_0_label}" />
								<Label class="victory-chip-name" hittest="false" text="{s:v_chip_0_name}" />
							</Panel>
							<Panel id="v_chip_1" class="victory-chip hidden" hittest="false">
								<Panel class="victory-chip-accent" hittest="false" />
								<Label class="victory-chip-label" hittest="false" text="{s:v_chip_1_label}" />
								<Label class="victory-chip-name" hittest="false" text="{s:v_chip_1_name}" />
							</Panel>
							<Panel id="v_chip_2" class="victory-chip hidden" hittest="false">
								<Panel class="victory-chip-accent" hittest="false" />
								<Label class="victory-chip-label" hittest="false" text="{s:v_chip_2_label}" />
								<Label class="victory-chip-name" hittest="false" text="{s:v_chip_2_name}" />
							</Panel>
							<Panel id="v_chip_3" class="victory-chip hidden" hittest="false">
								<Panel class="victory-chip-accent" hittest="false" />
								<Label class="victory-chip-label" hittest="false" text="{s:v_chip_3_label}" />
								<Label class="victory-chip-name" hittest="false" text="{s:v_chip_3_name}" />
							</Panel>
						</Panel>
						<Panel id="v_restart" class="victory-restart hidden" hittest="false">
							<Label class="victory-restart-label" hittest="false" text="{s:v_restart_label}" />
							<Label class="victory-restart-eta" hittest="false" text="{s:v_restart_eta}" />
						</Panel>
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
