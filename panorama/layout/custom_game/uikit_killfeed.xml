<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_killfeed.vcss_c" />
	</styles>

	<!-- uikit:killfeed rows=5 -->
	<!--
		GENERATED by `python -m uikit generate`.
		Kill feed, top right: 5 row(s) kf_<n>, newest on top.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_killfeed_root" class="uikit-fill hidden" hittest="false">
			<Panel class="kf-list" hittest="false">
				<Panel id="kf_0" class="kf-row hidden" hittest="false">
					<Label id="kf_0_attacker" class="kf-attacker" hittest="false" text="{s:kf_0_attacker}" />
					<Label id="kf_0_tag" class="kf-tag" hittest="false" text="{s:kf_0_tag}" />
					<Label class="kf-victim" hittest="false" text="{s:kf_0_victim}" />
				</Panel>
				<Panel id="kf_1" class="kf-row hidden" hittest="false">
					<Label id="kf_1_attacker" class="kf-attacker" hittest="false" text="{s:kf_1_attacker}" />
					<Label id="kf_1_tag" class="kf-tag" hittest="false" text="{s:kf_1_tag}" />
					<Label class="kf-victim" hittest="false" text="{s:kf_1_victim}" />
				</Panel>
				<Panel id="kf_2" class="kf-row hidden" hittest="false">
					<Label id="kf_2_attacker" class="kf-attacker" hittest="false" text="{s:kf_2_attacker}" />
					<Label id="kf_2_tag" class="kf-tag" hittest="false" text="{s:kf_2_tag}" />
					<Label class="kf-victim" hittest="false" text="{s:kf_2_victim}" />
				</Panel>
				<Panel id="kf_3" class="kf-row hidden" hittest="false">
					<Label id="kf_3_attacker" class="kf-attacker" hittest="false" text="{s:kf_3_attacker}" />
					<Label id="kf_3_tag" class="kf-tag" hittest="false" text="{s:kf_3_tag}" />
					<Label class="kf-victim" hittest="false" text="{s:kf_3_victim}" />
				</Panel>
				<Panel id="kf_4" class="kf-row hidden" hittest="false">
					<Label id="kf_4_attacker" class="kf-attacker" hittest="false" text="{s:kf_4_attacker}" />
					<Label id="kf_4_tag" class="kf-tag" hittest="false" text="{s:kf_4_tag}" />
					<Label class="kf-victim" hittest="false" text="{s:kf_4_victim}" />
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
