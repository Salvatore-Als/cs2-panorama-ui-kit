					<Label id="c_bl_line_2_value" class="card-line-value" hittest="false" text="{s:c_bl_line_2_value}" />
				</Panel>
				<Panel id="c_bl_line_3" class="card-line hidden" hittest="false">
					<Label id="c_bl_line_3_label" class="card-line-label" hittest="false" text="{s:c_bl_line_3_label}" />
					<Label id="c_bl_line_3_value" class="card-line-value" hittest="false" text="{s:c_bl_line_3_value}" />
				</Panel>
			</Panel>
			<Panel id="c_br" class="card card-br hidden" hittest="false">
				<Label id="c_br_title" class="card-title" hittest="false" text="{s:c_br_title}" />
				<Label id="c_br_desc" class="card-desc" hittest="false" text="{s:c_br_desc}" />
				<Panel id="c_br_line_0" class="card-line hidden" hittest="false">
					<Label id="c_br_line_0_label" class="card-line-label" hittest="false" text="{s:c_br_line_0_label}" />
					<Label id="c_br_line_0_value" class="card-line-value" hittest="false" text="{s:c_br_line_0_value}" />
				</Panel>
				<Panel id="c_br_line_1" class="card-line hidden" hittest="false">
					<Label id="c_br_line_1_label" class="card-line-label" hittest="false" text="{s:c_br_line_1_label}" />
					<Label id="c_br_line_1_value" class="card-line-value" hittest="false" text="{s:c_br_line_1_value}" />
				</Panel>
				<Panel id="c_br_line_2" class="card-line hidden" hittest="false">
					<Label id="c_br_line_2_label" class="card-line-label" hittest="false" text="{s:c_br_line_2_label}" />
					<Label id="c_br_line_2_value" class="card-line-value" hittest="false" text="{s:c_br_line_2_value}" />
				</Panel>
				<Panel id="c_br_line_3" class="card-line hidden" hittest="false">
					<Label id="c_br_line_3_label" class="card-line-label" hittest="false" text="{s:c_br_line_3_label}" />
