<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_card.vcss_c" />
	</styles>

	<!-- uikit:card placements=tl,tr,bl,br lines=4 -->
	<!--
		GENERATED by `python -m uikit generate`.
		Card: 4 corner(s) x title / description / 4 line(s). Every part is optional.
		No animation: the card is there when `hidden` goes.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_card_root" class="uikit-fill hidden" hittest="false">
			<Panel id="c_tl" class="card card-tl hidden" hittest="false">
				<Label id="c_tl_title" class="card-title" hittest="false" text="{s:c_tl_title}" />
				<Label id="c_tl_desc" class="card-desc" hittest="false" text="{s:c_tl_desc}" />
				<Panel id="c_tl_line_0" class="card-line hidden" hittest="false">
					<Label id="c_tl_line_0_label" class="card-line-label" hittest="false" text="{s:c_tl_line_0_label}" />
					<Label id="c_tl_line_0_value" class="card-line-value" hittest="false" text="{s:c_tl_line_0_value}" />
				</Panel>
				<Panel id="c_tl_line_1" class="card-line hidden" hittest="false">
					<Label id="c_tl_line_1_label" class="card-line-label" hittest="false" text="{s:c_tl_line_1_label}" />
					<Label id="c_tl_line_1_value" class="card-line-value" hittest="false" text="{s:c_tl_line_1_value}" />
				</Panel>
				<Panel id="c_tl_line_2" class="card-line hidden" hittest="false">
					<Label id="c_tl_line_2_label" class="card-line-label" hittest="false" text="{s:c_tl_line_2_label}" />
					<Label id="c_tl_line_2_value" class="card-line-value" hittest="false" text="{s:c_tl_line_2_value}" />
				</Panel>
				<Panel id="c_tl_line_3" class="card-line hidden" hittest="false">
					<Label id="c_tl_line_3_label" class="card-line-label" hittest="false" text="{s:c_tl_line_3_label}" />
					<Label id="c_tl_line_3_value" class="card-line-value" hittest="false" text="{s:c_tl_line_3_value}" />
				</Panel>
			</Panel>
			<Panel id="c_tr" class="card card-tr hidden" hittest="false">
				<Label id="c_tr_title" class="card-title" hittest="false" text="{s:c_tr_title}" />
				<Label id="c_tr_desc" class="card-desc" hittest="false" text="{s:c_tr_desc}" />
				<Panel id="c_tr_line_0" class="card-line hidden" hittest="false">
					<Label id="c_tr_line_0_label" class="card-line-label" hittest="false" text="{s:c_tr_line_0_label}" />
					<Label id="c_tr_line_0_value" class="card-line-value" hittest="false" text="{s:c_tr_line_0_value}" />
				</Panel>
				<Panel id="c_tr_line_1" class="card-line hidden" hittest="false">
					<Label id="c_tr_line_1_label" class="card-line-label" hittest="false" text="{s:c_tr_line_1_label}" />
					<Label id="c_tr_line_1_value" class="card-line-value" hittest="false" text="{s:c_tr_line_1_value}" />
				</Panel>
				<Panel id="c_tr_line_2" class="card-line hidden" hittest="false">
					<Label id="c_tr_line_2_label" class="card-line-label" hittest="false" text="{s:c_tr_line_2_label}" />
					<Label id="c_tr_line_2_value" class="card-line-value" hittest="false" text="{s:c_tr_line_2_value}" />
				</Panel>
				<Panel id="c_tr_line_3" class="card-line hidden" hittest="false">
					<Label id="c_tr_line_3_label" class="card-line-label" hittest="false" text="{s:c_tr_line_3_label}" />
