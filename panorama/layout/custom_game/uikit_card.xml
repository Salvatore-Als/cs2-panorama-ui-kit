				</Panel>
			</Panel>
			<Panel id="c_bl" class="card card-bl hidden" hittest="false">
				<Label id="c_bl_title" class="card-title" hittest="false" text="{s:c_bl_title}" />
				<Label id="c_bl_desc" class="card-desc" hittest="false" text="{s:c_bl_desc}" />
				<Panel id="c_bl_line_0" class="card-line hidden" hittest="false">
					<Label id="c_bl_line_0_label" class="card-line-label" hittest="false" text="{s:c_bl_line_0_label}" />
					<Label id="c_bl_line_0_value" class="card-line-value" hittest="false" text="{s:c_bl_line_0_value}" />
				</Panel>
				<Panel id="c_bl_line_1" class="card-line hidden" hittest="false">
					<Label id="c_bl_line_1_label" class="card-line-label" hittest="false" text="{s:c_bl_line_1_label}" />
