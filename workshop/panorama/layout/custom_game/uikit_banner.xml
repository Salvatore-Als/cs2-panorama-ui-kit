<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_banner.vcss_c" />
	</styles>

	<!-- uikit:banner -->
	<!--
		GENERATED by `python -m uikit generate`.
		Banner: one line near the top, flanked by accent rules.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_banner_root" class="uikit-fill hidden" hittest="false">
			<Panel id="b_card" class="banner" hittest="false">
				<Panel class="banner-line" hittest="false" />
				<Panel class="banner-body" hittest="false">
					<Label id="b_kicker" class="banner-kicker" hittest="false" text="{s:b_kicker}" />
					<Label class="banner-text" hittest="false" text="{s:b_text}" />
				</Panel>
				<Panel class="banner-line" hittest="false" />
			</Panel>
		</Panel>
	</Panel>
</root>
