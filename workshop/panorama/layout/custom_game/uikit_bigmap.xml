<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_bigmap.vcss_c" />
	</styles>

	<!-- uikit:minimap marks=16 -->
	<!--
		GENERATED by `python -m uikit generate`.
		Minimap: map picture, current and next zone circles, 16 marker(s).
		Positions are x-N / y-N on two nested panels (one transform per axis), radii r-N on the ring,
		a shrink is dur-N then the target classes, run by the client.
		Zoom: everything on the map sits in mm_zoom (zoom-*, a scale) > mm_pan / mm_pan_y (px-* / py-*, centre on the player).

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_bigmap_root" class="uikit-fill hidden" hittest="false">
			<Panel id="mm_frame" class="minimap hidden" hittest="false">
				<Panel class="minimap-veil" hittest="false" />
				<Panel class="minimap-box" hittest="false">
					<Panel id="mm_map" class="minimap-map" hittest="false">
						<Panel id="mm_zoom" class="mm-zoom" hittest="false">
							<Panel id="mm_pan" class="mm-pan" hittest="false">
								<Panel id="mm_pan_y" class="mm-pan-y" hittest="false">
									<Panel class="minimap-world" hittest="false" />
									<Panel id="mm_zone_next" class="mm-zone mm-zone-next hidden" hittest="false">
										<Panel id="mm_zone_next_y" class="mm-zone-y" hittest="false">
											<Panel id="mm_zone_next_ring" class="mm-ring" hittest="false" />
										</Panel>
									</Panel>
									<Panel id="mm_zone_cur" class="mm-zone mm-zone-cur hidden" hittest="false">
										<Panel id="mm_zone_cur_y" class="mm-zone-y" hittest="false">
											<Panel id="mm_zone_cur_ring" class="mm-ring" hittest="false" />
										</Panel>
									</Panel>
									<Panel id="mm_mark_0" class="mm-mark hidden" hittest="false">
										<Panel id="mm_mark_0_y" class="mm-mark-y" hittest="false">
											<Panel class="mm-mark-halo" hittest="false" />
											<Panel id="mm_mark_0_icon" class="mm-mark-icon" hittest="false" />
											<Label id="mm_mark_0_label" class="mm-mark-label" hittest="false" text="{s:mm_mark_0_label}" />
										</Panel>
									</Panel>
									<Panel id="mm_mark_1" class="mm-mark hidden" hittest="false">
