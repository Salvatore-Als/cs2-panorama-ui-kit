<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_compass.vcss_c" />
	</styles>

	<!-- uikit:compass pins=4 -->
	<!--
		GENERATED by `python -m uikit generate`.
		Compass: a strip of 15-degree cells (-180..540) in a clipped viewport, 4 pin(s) over it.
		hd-N on cp_strip slides the heading under the caret; rel-N / edge-l / edge-r on a pin place it.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_compass_root" class="uikit-fill hidden" hittest="false">
			<Panel id="cp_bar" class="compass hidden" hittest="false">
				<Panel class="compass-frame" hittest="false">
					<Panel class="compass-view" hittest="false">
						<Panel id="cp_strip" class="compass-strip" hittest="false">
							<Panel class="compass-cell compass-cardinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="S" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="SW" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="W" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="NW" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal compass-north" hittest="false">
								<Label class="compass-letter" hittest="false" text="N" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="NE" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="E" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="SE" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="S" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="SW" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="W" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="NW" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal compass-north" hittest="false">
								<Label class="compass-letter" hittest="false" text="N" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="NE" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="E" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-ordinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="SE" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell" hittest="false"><Panel class="compass-tick" hittest="false" /></Panel>
							<Panel class="compass-cell compass-cardinal" hittest="false">
								<Label class="compass-letter" hittest="false" text="S" />
								<Panel class="compass-tick" hittest="false" />
							</Panel>
						</Panel>
						<Panel class="compass-fade compass-fade-l" hittest="false" />
						<Panel class="compass-fade compass-fade-r" hittest="false" />
					</Panel>
					<Panel class="compass-pins" hittest="false">
						<Panel id="cp_pin_0" class="compass-pin hidden" hittest="false">
							<Panel class="compass-pin-icon" hittest="false" />
							<Panel class="compass-pin-arrow" hittest="false" />
							<Label id="cp_pin_0_dist" class="compass-pin-dist" hittest="false" text="{s:cp_pin_0_dist}" />
						</Panel>
						<Panel id="cp_pin_1" class="compass-pin hidden" hittest="false">
							<Panel class="compass-pin-icon" hittest="false" />
							<Panel class="compass-pin-arrow" hittest="false" />
							<Label id="cp_pin_1_dist" class="compass-pin-dist" hittest="false" text="{s:cp_pin_1_dist}" />
						</Panel>
						<Panel id="cp_pin_2" class="compass-pin hidden" hittest="false">
							<Panel class="compass-pin-icon" hittest="false" />
							<Panel class="compass-pin-arrow" hittest="false" />
							<Label id="cp_pin_2_dist" class="compass-pin-dist" hittest="false" text="{s:cp_pin_2_dist}" />
						</Panel>
						<Panel id="cp_pin_3" class="compass-pin hidden" hittest="false">
							<Panel class="compass-pin-icon" hittest="false" />
							<Panel class="compass-pin-arrow" hittest="false" />
							<Label id="cp_pin_3_dist" class="compass-pin-dist" hittest="false" text="{s:cp_pin_3_dist}" />
						</Panel>
					</Panel>
					<Panel class="compass-caret" hittest="false" />
				</Panel>
				<Label class="compass-deg" hittest="false" text="{s:cp_deg}" />
			</Panel>
		</Panel>
	</Panel>
</root>
