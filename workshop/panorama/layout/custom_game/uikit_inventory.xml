<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_inventory.vcss_c" />
	</styles>

	<!-- uikit:inventory slots=6 -->
	<!--
		GENERATED by `python -m uikit generate`.
		Inventory: a row of 6 tile(s) at the bottom centre. Tile inv_<n>.
		item-<name> on inv_<n>_icon sets the icon; the name shows under the selected tile.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_inventory_root" class="uikit-fill hidden" hittest="false">
			<Panel id="inv_bar" class="inv-bar" hittest="false">
				<Panel id="inv_0" class="inv-slot hidden" hittest="false">
					<Panel class="inv-tile" hittest="false">
						<Panel class="inv-accent" hittest="false" />
						<Panel id="inv_0_icon" class="inv-icon" hittest="false" />
						<Label id="inv_0_key" class="inv-key" hittest="false" text="{s:inv_0_key}" />
						<Label id="inv_0_count" class="inv-count" hittest="false" text="{s:inv_0_count}" />
					</Panel>
					<Label id="inv_0_name" class="inv-name" hittest="false" text="{s:inv_0_name}" />
				</Panel>
				<Panel id="inv_1" class="inv-slot hidden" hittest="false">
					<Panel class="inv-tile" hittest="false">
						<Panel class="inv-accent" hittest="false" />
						<Panel id="inv_1_icon" class="inv-icon" hittest="false" />
						<Label id="inv_1_key" class="inv-key" hittest="false" text="{s:inv_1_key}" />
						<Label id="inv_1_count" class="inv-count" hittest="false" text="{s:inv_1_count}" />
					</Panel>
					<Label id="inv_1_name" class="inv-name" hittest="false" text="{s:inv_1_name}" />
				</Panel>
				<Panel id="inv_2" class="inv-slot hidden" hittest="false">
					<Panel class="inv-tile" hittest="false">
						<Panel class="inv-accent" hittest="false" />
						<Panel id="inv_2_icon" class="inv-icon" hittest="false" />
						<Label id="inv_2_key" class="inv-key" hittest="false" text="{s:inv_2_key}" />
						<Label id="inv_2_count" class="inv-count" hittest="false" text="{s:inv_2_count}" />
					</Panel>
					<Label id="inv_2_name" class="inv-name" hittest="false" text="{s:inv_2_name}" />
				</Panel>
				<Panel id="inv_3" class="inv-slot hidden" hittest="false">
					<Panel class="inv-tile" hittest="false">
						<Panel class="inv-accent" hittest="false" />
						<Panel id="inv_3_icon" class="inv-icon" hittest="false" />
						<Label id="inv_3_key" class="inv-key" hittest="false" text="{s:inv_3_key}" />
						<Label id="inv_3_count" class="inv-count" hittest="false" text="{s:inv_3_count}" />
					</Panel>
					<Label id="inv_3_name" class="inv-name" hittest="false" text="{s:inv_3_name}" />
				</Panel>
				<Panel id="inv_4" class="inv-slot hidden" hittest="false">
					<Panel class="inv-tile" hittest="false">
						<Panel class="inv-accent" hittest="false" />
						<Panel id="inv_4_icon" class="inv-icon" hittest="false" />
						<Label id="inv_4_key" class="inv-key" hittest="false" text="{s:inv_4_key}" />
						<Label id="inv_4_count" class="inv-count" hittest="false" text="{s:inv_4_count}" />
					</Panel>
					<Label id="inv_4_name" class="inv-name" hittest="false" text="{s:inv_4_name}" />
				</Panel>
				<Panel id="inv_5" class="inv-slot hidden" hittest="false">
					<Panel class="inv-tile" hittest="false">
						<Panel class="inv-accent" hittest="false" />
						<Panel id="inv_5_icon" class="inv-icon" hittest="false" />
						<Label id="inv_5_key" class="inv-key" hittest="false" text="{s:inv_5_key}" />
						<Label id="inv_5_count" class="inv-count" hittest="false" text="{s:inv_5_count}" />
					</Panel>
					<Label id="inv_5_name" class="inv-name" hittest="false" text="{s:inv_5_name}" />
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
