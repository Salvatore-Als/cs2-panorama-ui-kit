<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_comms.vcss_c" />
	</styles>

	<!-- uikit:comms -->
	<!--
		GENERATED by `python -m uikit generate`.
		Comms: radio transmission card on the left. Kicker with rec dot and signal bars,
		a hologram portrait (face-<name> on cm_face: three layers, the main one and two colour ghosts,
		under 45 scanlines, a moving scan band and a static layer), name, text, footer.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_comms_root" class="uikit-fill hidden" hittest="false">
			<Panel id="cm_card" class="comms" hittest="false">
				<Panel class="comms-head" hittest="false">
					<Panel class="comms-rec" hittest="false" />
					<Label id="cm_kicker" class="comms-kicker" hittest="false" text="{s:cm_kicker}" />
					<Panel class="comms-signal" hittest="false">
						<Panel class="comms-signal-bar comms-signal-bar-1" hittest="false" />
						<Panel class="comms-signal-bar comms-signal-bar-2" hittest="false" />
						<Panel class="comms-signal-bar comms-signal-bar-3" hittest="false" />
						<Panel class="comms-signal-bar comms-signal-bar-4" hittest="false" />
					</Panel>
				</Panel>
				<Panel class="comms-body" hittest="false">
					<Panel class="comms-portrait" hittest="false">
						<Panel class="comms-portrait-glow" hittest="false" />
						<Panel id="cm_face" class="comms-face" hittest="false">
							<Panel class="comms-face-layer comms-face-ghost-r" hittest="false" />
							<Panel class="comms-face-layer comms-face-ghost-b" hittest="false" />
							<Panel class="comms-face-layer comms-face-main" hittest="false" />
						</Panel>
						<Panel class="comms-scanlines" hittest="false">
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
							<Panel class="comms-scanline" hittest="false" />
						</Panel>
						<Panel class="comms-scanband" hittest="false" />
						<Panel class="comms-noise" hittest="false" />
						<Panel class="comms-corner comms-corner-tl" hittest="false" />
						<Panel class="comms-corner comms-corner-br" hittest="false" />
					</Panel>
					<Panel class="comms-copy" hittest="false">
						<Label id="cm_name" class="comms-name" hittest="false" text="{s:cm_name}" />
						<Label class="comms-text" hittest="false" text="{s:cm_text}" />
						<Label id="cm_footer" class="comms-footer" hittest="false" text="{s:cm_footer}" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
