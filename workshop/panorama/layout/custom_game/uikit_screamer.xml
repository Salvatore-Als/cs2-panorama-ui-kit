<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_screamer.vcss_c" />
	</styles>

	<!-- uikit:screamer -->
	<!--
		GENERATED by `python -m uikit generate`.
		Screamer: one full-screen picture.
		scare-<name> on sc_image sets the picture; the kit plays the sound from the server.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_screamer_root" class="uikit-fill hidden" hittest="false">
			<Panel id="sc_image" class="screamer hidden" hittest="false" />
		</Panel>
	</Panel>
</root>
