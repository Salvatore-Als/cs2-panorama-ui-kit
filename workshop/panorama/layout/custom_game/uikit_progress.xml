<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_progress.vcss_c" />
	</styles>

	<!-- uikit:progress placements=t,c,b -->
	<!--
		GENERATED by `python -m uikit generate`.
		Progress: 3 bar(s), each a label / value row over a track.
		The fill is a clip: step-N for a pushed value, timed + dur-N + run for a bar that runs alone.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_progress_root" class="uikit-fill hidden" hittest="false">
			<Panel class="progress-zone progress-zone-t" hittest="false">
				<Panel id="pg_t" class="progress progress-t hidden" hittest="false">
					<Panel class="progress-head" hittest="false">
						<Label id="pg_t_label" class="progress-label" hittest="false" text="{s:pg_t_label}" />
						<Label id="pg_t_value" class="progress-value" hittest="false" text="{s:pg_t_value}" />
					</Panel>
					<Panel class="progress-track" hittest="false">
						<Panel id="pg_t_fill" class="progress-fill" hittest="false" />
					</Panel>
				</Panel>
			</Panel>
			<Panel class="progress-zone progress-zone-c" hittest="false">
				<Panel id="pg_c" class="progress progress-c hidden" hittest="false">
					<Panel class="progress-head" hittest="false">
						<Label id="pg_c_label" class="progress-label" hittest="false" text="{s:pg_c_label}" />
						<Label id="pg_c_value" class="progress-value" hittest="false" text="{s:pg_c_value}" />
					</Panel>
					<Panel class="progress-track" hittest="false">
						<Panel id="pg_c_fill" class="progress-fill" hittest="false" />
					</Panel>
				</Panel>
			</Panel>
			<Panel class="progress-zone progress-zone-b" hittest="false">
				<Panel id="pg_b" class="progress progress-b hidden" hittest="false">
					<Panel class="progress-head" hittest="false">
						<Label id="pg_b_label" class="progress-label" hittest="false" text="{s:pg_b_label}" />
						<Label id="pg_b_value" class="progress-value" hittest="false" text="{s:pg_b_value}" />
					</Panel>
					<Panel class="progress-track" hittest="false">
						<Panel id="pg_b_fill" class="progress-fill" hittest="false" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
