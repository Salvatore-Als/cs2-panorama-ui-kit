<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_overlay.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_overlay_fx.vcss_c" />
	</styles>

	<!-- uikit:overlay -->
	<!--
		GENERATED by `python -m uikit generate`.
		Overlay: one full-screen effect, ov_fx. fx-<name> picks it (OverlayEffects).
		8 layers and 40 particles, styled in uikit_overlay_fx.css (tools/overlay_fx.py).

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_overlay_root" class="uikit-fill hidden" hittest="false">
			<Panel id="ov_fx" class="ov-fx hidden" hittest="false">
				<Panel class="ov-fx-l ov-fx-l0" hittest="false" />
				<Panel class="ov-fx-l ov-fx-l1" hittest="false" />
