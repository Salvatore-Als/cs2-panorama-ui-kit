						<Label class="ab-cd" hittest="false" text="{s:ab_0_cd}" />
						<Panel class="ab-gauge" hittest="false">
							<Panel id="ab_0_bar" class="ab-bar" hittest="false" />
							<Panel id="ab_0_hold" class="ab-hold" hittest="false" />
