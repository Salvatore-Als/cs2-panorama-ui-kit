<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/uikit_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/uikit_announce.vcss_c" />
	</styles>

	<!-- uikit:announce -->
	<!--
		GENERATED by `python -m uikit generate`.
		Announce: centred card, kicker / title / description.
		The title slams in only under animate-title.

		Slot reference: docs/CONTRACTS.md, or `python -m uikit slots <component>`.
		Root authored hidden: a custom_hud_layout is shown to every player; per-player state only overlays.
	-->
	<Panel class="uikit-screen" hittest="false">
		<Panel id="uikit_announce_root" class="uikit-fill hidden" hittest="false">
			<Panel id="a_card" class="announce" hittest="false">
				<Label id="a_kicker" class="announce-kicker" hittest="false" text="{s:a_kicker}" />
				<Label class="announce-title" hittest="false" text="{s:a_title}" />
				<Label id="a_desc" class="announce-desc" hittest="false" text="{s:a_desc}" />
			</Panel>
		</Panel>
	</Panel>
</root>
