{
  "component": "card",
  "csharp": "CardLayout / ICardService",
  "summary": "Static info card pinned to a screen corner (over the radar, or above the HUD). Title, description and lines are all optional. No animation.",
  "params": {
    "placements": {
      "default": [
        "tl",
        "tr",
        "bl",
        "br"
      ],
      "doc": "Corner codes the layout has a card for (CardLayout.Placements)."
    },
    "lines": {
      "default": 4,
      "doc": "Label / value lines per card (CardLayout.Lines)."
    }
  },
  "repeat": {
    "p": "placements",
    "n": "lines"
  },
  "panels": [
    {
      "id": "c_{p}",
      "required": true,
      "classes": [
        "hidden",
        "style-*"
      ],
      "doc": "The card. Author it with class `hidden`: it appears when the class is dropped, with no transition."
    },
    {
      "id": "c_{p}_title",
      "required": false,
      "classes": [
        "empty"
      ],
      "doc": "Label of the title, `empty` when blank."
    },
    {
      "id": "c_{p}_desc",
      "required": false,
      "classes": [
        "empty"
      ],
      "doc": "Label of the description, `empty` when blank."
    },
    {
      "id": "c_{p}_line_{n}",
      "required": true,
      "classes": [
        "hidden"
      ],
      "doc": "One line. Author it with class `hidden`; unused lines stay hidden."
    },
    {
      "id": "c_{p}_line_{n}_label",
      "required": false,
      "classes": [
        "empty"
      ],
      "doc": "Label of the line's left text, `empty` when blank."
    },
    {
      "id": "c_{p}_line_{n}_value",
      "required": false,
      "classes": [
        "empty"
      ],
      "doc": "Label of the line's right text, `empty` when blank."
    }
  ],
  "texts": [
    {
      "var": "c_{p}_title",
      "required": false,
      "doc": "CardOptions.Title"
    },
    {
      "var": "c_{p}_desc",
      "required": false,
      "doc": "CardOptions.Description"
    },
    {
      "var": "c_{p}_line_{n}_label",
      "required": false,
      "doc": "CardLine.Label"
    },
    {
      "var": "c_{p}_line_{n}_value",
      "required": false,
      "doc": "CardLine.Value"
    },
    {
      "var": "c_{p}_<key>",
      "required": false,
      "extra": true,
      "doc": "CardOptions.Texts[key]"
    }
  ],
  "css": [
    "hidden",
    "style-neutral",
    "style-info",
    "style-success",
    "style-warn",
    "style-danger"
  ]
}